// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profilFiscal  ProfilFiscal?
  aiConfig      AIConfig?
  documents     DocumentUpload[]
  journalEntries JournalEntry[]
  friendLinks   FriendLink[]
  badges        UserBadge[]
  simulations   Simulation[]
  preferences   UserPreferences?

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProfilFiscal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Wizard progression
  wizardStep      Int      @default(1)
  isComplete      Boolean  @default(false)
  lastCompletedAt DateTime?

  // Étape 1: Situation personnelle
  statut            String?
  nombreParts       Float?
  commune           String?
  age               Int?

  // Étape 2: Revenus
  salaireBrut       Float?
  salaireNet        Float?
  typeContrat       String?
  revenusFonciers   Float?
  revenusCapitaux   Float?
  autresRevenus     Float?

  // Étape 3: Patrimoine
  proprietaire      Boolean?
  valeurLocative    Float?
  taxeFonciere      Float?
  vehicules         Json?
  patrimoineIFI     Float?

  // Étape 4: Consommation
  modeConsommation  String?
  budgetMensuel     Json?
  detailCategories  Json?
  alcoolTabac       Json?

  // Étape 5: Famille & Services
  nombreEnfants     Int?
  enfantsDetails    Json?
  frequenceServices Json?
  aides             Json?

  // Statut des données (JSON avec {fieldName: "VERIFIE" | "DECLARE" | "ESTIME"})
  statusData        Json     @default("{}")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Referentiel {
  id               String   @id @default(cuid())
  millesime        String
  categorie        String
  cle              String
  valeur           Json
  unite            String?
  source           String
  urlSource        String
  datePublication  DateTime
  dateIntegration  DateTime @default(now())
  statut           String
  notes            String?

  @@unique([millesime, categorie, cle])
}

model ScoreFiscal {
  id          String   @id @default(cuid())
  userId      String
  annee       Int
  millesime   String

  totalPaye   Float
  detailPaye  Json
  totalRecu   Float
  detailRecu  Json

  soldeNet         Float
  ratio            Float
  scoreConfiance   Float

  sourcesUtilisees Json
  hypotheses       Json
  margeErreur      Float?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
}

model DocumentUpload {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String
  uploadedAt    DateTime @default(now())
  status        String
  extractedData Json?

  createdAt     DateTime @default(now())
}

model JournalEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  enseigne      String?
  montantTTC    Float
  detailLignes  Json?
  montantTVA    Float?
  categorie     String?
  statut        String

  createdAt     DateTime @default(now())
}

model AIConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  apiKey            String
  endpoint          String?
  model             String
  temperature       Float    @default(0.3)
  maxTokens         Int      @default(2048)
  customSystemPrompt String?

  lastTestedAt      DateTime?
  lastTestStatus    String   @default("UNTESTED")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Json?
}

model FriendLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  friendId  String
  status    String
  createdAt DateTime @default(now())
}

model Simulation {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  scenarioType       String
  parametresModifies Json
  resultat           Json

  createdAt          DateTime @default(now())
}

model UserPreferences {
  id                         String  @id @default(cuid())
  userId                     String  @unique
  user                       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationsEnabled       Boolean @default(true)
  taxFactDailyEnabled        Boolean @default(false)
  fiscalCalendarAlertsEnabled Boolean @default(true)

  preferredMillesime         String?
  showEstimatedData          Boolean @default(true)
  showDeclaredData           Boolean @default(true)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
