// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profilFiscal           ProfilFiscal?
  aiConfig               AIConfig?
  documents              DocumentUpload[]
  journalEntries         JournalEntry[]
  friendLinks            FriendLink[]
  badges                 UserBadge[]
  challenges             UserChallenge[]
  streak                 UserStreak?
  simulations            Simulation[]
  preferences            UserPreferences?
  notificationPreferences UserNotificationPreferences?
  notifications          Notification[]
  scoreHistory           ScoreHistory[]
  quizAttempts           QuizAttempt[]
  sharedAnimations       SharedAnimation[]

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProfilFiscal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Wizard progression
  wizardStep      Int      @default(1)
  isComplete      Boolean  @default(false)
  lastCompletedAt DateTime?

  // Étape 1: Situation personnelle
  statut            String?
  nombreParts       Float?
  commune           String?
  age               Int?

  // Étape 2: Revenus
  salaireBrut       Float?
  salaireNet        Float?
  typeContrat       String?
  revenusFonciers   Float?
  revenusCapitaux   Float?
  autresRevenus     Float?

  // Étape 3: Patrimoine
  proprietaire      Boolean?
  valeurLocative    Float?
  taxeFonciere      Float?
  vehicules         Json?
  patrimoineIFI     Float?

  // Étape 4: Consommation
  modeConsommation  String?
  budgetMensuel     Json?
  detailCategories  Json?
  alcoolTabac       Json?

  // Étape 5: Famille & Services
  nombreEnfants     Int?
  enfantsDetails    Json?
  frequenceServices Json?
  aides             Json?

  // Statut des données (JSON avec {fieldName: "VERIFIE" | "DECLARE" | "ESTIME"})
  statusData        Json     @default("{}")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Referentiel {
  id               String   @id @default(cuid())
  millesime        String
  categorie        String
  cle              String
  valeur           Json
  unite            String?
  source           String
  urlSource        String
  datePublication  DateTime
  dateIntegration  DateTime @default(now())
  statut           String
  notes            String?

  @@unique([millesime, categorie, cle])
}

model ScoreFiscal {
  id          String   @id @default(cuid())
  userId      String
  annee       Int
  millesime   String

  totalPaye   Float
  detailPaye  Json
  totalRecu   Float
  detailRecu  Json

  soldeNet         Float
  ratio            Float
  scoreConfiance   Float

  sourcesUtilisees Json
  hypotheses       Json
  margeErreur      Float?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
}

model DocumentUpload {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String
  uploadedAt    DateTime @default(now())
  status        String
  extractedData Json?

  createdAt     DateTime @default(now())
}

model JournalEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  enseigne      String?
  montantTTC    Float
  detailLignes  Json?
  montantTVA    Float?
  categorie     String?
  statut        String

  createdAt     DateTime @default(now())
}

model AIConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  apiKey            String
  endpoint          String?
  model             String
  temperature       Float    @default(0.3)
  maxTokens         Int      @default(2048)
  customSystemPrompt String?

  lastTestedAt      DateTime?
  lastTestStatus    String   @default("UNTESTED")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Float    @default(0)

  @@index([userId])
}

model UserChallenge {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  challengeId  String
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  progress     Int       @default(0)
  target       Int
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  expiresAt    DateTime?

  @@index([userId, status])
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastLoggedDate  DateTime?
  freezeTokens    Int       @default(0)
  gracePeriodEnds DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FriendLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  friendId  String
  status    String
  createdAt DateTime @default(now())
}

model Simulation {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String?
  scenarioType       String   // NEW_CHILD, JOB_CHANGE, RELOCATION, RETIREMENT, SALARY_CHANGE, CUSTOM
  inputData          Json     // Modified profile fields
  outputScore        Json     // Complete ScoreFiscal result

  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

model UserPreferences {
  id                         String  @id @default(cuid())
  userId                     String  @unique
  user                       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationsEnabled       Boolean @default(true)
  taxFactDailyEnabled        Boolean @default(false)
  fiscalCalendarAlertsEnabled Boolean @default(true)

  preferredMillesime         String?
  showEstimatedData          Boolean @default(true)
  showDeclaredData           Boolean @default(true)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model ProfilType {
  id        String   @id  // "enseignant", "medecin", "artisan", "cadre", "retraite", "etudiant", "smicard"
  data      Json     // ProfilFiscalComplete data
  score     Json     // Pre-calculated ScoreFiscal
  updatedAt DateTime @default(now()) @updatedAt
}

model UserNotificationPreferences {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyFactsEnabled   Boolean @default(false)
  fiscalAlertsEnabled Boolean @default(true)
  weeklyDigestEnabled Boolean @default(false)

  emailChannel        Boolean @default(true)
  pushChannel         Boolean @default(false)
  inAppChannel        Boolean @default(true)

  quietHoursStart     Int     @default(22) // 10pm
  quietHoursEnd       Int     @default(8)  // 8am
  timezone            String  @default("Europe/Paris")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ScoreHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  month           Int      // 1-12
  year            Int      // 2026
  scoreFiscalData Json     // Complete ScoreFiscal object snapshot
  confidenceScore Float
  millesime       String   // Which barème version was used

  createdAt       DateTime @default(now())

  @@unique([userId, year, month])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // DAILY_FACT, FISCAL_ALERT, WEEKLY_DIGEST, EVENT_TRIGGERED
  title     String
  body      String   @db.Text
  data      Json?
  channels  String[] // ['email', 'push', 'in-app']

  read      Boolean  @default(false)
  sentAt    DateTime @default(now())

  @@index([userId, read, sentAt])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizType   String   // GENERIC, PERSONALIZED, FOCUSED, CHALLENGE
  questions  Json     // Array of question objects
  answers    Json     // Array of user's answers
  score      Int      // Number of correct answers
  totalQuestions Int

  completedAt DateTime @default(now())

  @@index([userId, completedAt])
}

model SharedAnimation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  animationData Json     // Anonymized FiscalDayData
  expiresAt     DateTime
  viewCount     Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
}
