// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Phase 4: Social preferences
  socialPreferences Json?  // { leaderboardOptIn: boolean, showActivity: boolean, discoveryEnabled: boolean }
  adminRole         String? // SUPER_ADMIN, DATA_ADMIN, SUPPORT_ADMIN, ANALYTICS_VIEWER

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profilFiscal           ProfilFiscal?
  aiConfig               AIConfig?
  aiUsages               AIUsage[]
  consents               UserConsent[]
  documents              DocumentUpload[]
  journalEntries         JournalEntry[]
  friends                Friend[]           @relation(name: "UserFriends")
  friendOf               Friend[]           @relation(name: "FriendOf")
  sentInvitations        FriendInvitation[] @relation(name: "SentInvitations")
  ownedGroups            Group[]            @relation(name: "OwnedGroups")
  groupMemberships       GroupMember[]      @relation(name: "GroupMemberships")
  friendLinks            FriendLink[]       @relation(name: "UserFriendLinks")
  badges                 UserBadge[]
  challenges             UserChallenge[]
  streak                 UserStreak?
  simulations            Simulation[]
  preferences            UserPreferences?
  notificationPreferences UserNotificationPreferences?
  notifications          Notification[]
  scoreHistory           ScoreHistory[]
  quizAttempts           QuizAttempt[]
  sharedAnimations       SharedAnimation[]
  wrappedGenerations     WrappedGeneration[]
  referentielReviews     ReferentielUpdate[] @relation(name: "ReferentielReviews")
  adminLogs              AdminLog[]          @relation(name: "AdminActions")

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProfilFiscal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Wizard progression
  wizardStep      Int      @default(1)
  isComplete      Boolean  @default(false)
  lastCompletedAt DateTime?

  // Étape 1: Situation personnelle
  statut            String?
  nombreParts       Float?
  commune           String?
  age               Int?

  // Étape 2: Revenus
  salaireBrut       Float?
  salaireNet        Float?
  typeContrat       String?
  revenusFonciers   Float?
  revenusCapitaux   Float?
  autresRevenus     Float?

  // Étape 3: Patrimoine
  proprietaire      Boolean?
  valeurLocative    Float?
  taxeFonciere      Float?
  vehicules         Json?
  patrimoineIFI     Float?

  // Étape 4: Consommation
  modeConsommation  String?
  budgetMensuel     Json?
  detailCategories  Json?
  alcoolTabac       Json?

  // Étape 5: Famille & Services
  nombreEnfants     Int?
  enfantsDetails    Json?
  frequenceServices Json?
  aides             Json?

  // Statut des données (JSON avec {fieldName: "VERIFIE" | "DECLARE" | "ESTIME"})
  statusData        Json     @default("{}")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Referentiel {
  id               String   @id @default(cuid())
  millesime        String
  categorie        String
  cle              String
  valeur           Json
  unite            String?
  source           String
  urlSource        String
  datePublication  DateTime
  dateIntegration  DateTime @default(now())
  statut           String
  notes            String?

  @@unique([millesime, categorie, cle])
}

model ReferentielUpdate {
  id           String    @id @default(cuid())
  millesime    String
  categorie    String
  cle          String
  source       String
  status       String    // DETECTED, PENDING_REVIEW, APPROVED, REJECTED

  oldValue     Json?
  newValue     Json
  diffSummary  String?   @db.Text

  detectedAt   DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?   // Admin user ID
  reviewer     User?     @relation(name: "ReferentielReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([millesime, categorie, cle])
}

model AdminLog {
  id           String   @id @default(cuid())
  adminUserId  String
  admin        User     @relation(name: "AdminActions", fields: [adminUserId], references: [id], onDelete: Cascade)

  action       String   // APPROVE_UPDATE, REJECT_UPDATE, SUSPEND_USER, DELETE_USER, MODIFY_REFERENTIEL, etc.
  resourceType String   // REFERENTIEL, USER, GROUP, etc.
  resourceId   String?
  details      Json?
  ipAddress    String?

  timestamp    DateTime @default(now())

  @@index([adminUserId, timestamp])
  @@index([resourceType, resourceId])
}

model ScoreFiscal {
  id          String   @id @default(cuid())
  userId      String
  annee       Int
  millesime   String

  totalPaye   Float
  detailPaye  Json
  totalRecu   Float
  detailRecu  Json

  soldeNet         Float
  ratio            Float
  scoreConfiance   Float

  sourcesUtilisees Json
  hypotheses       Json
  margeErreur      Float?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
}

model DocumentUpload {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String
  uploadedAt    DateTime @default(now())
  status        String
  extractedData Json?

  createdAt     DateTime @default(now())
}

model JournalEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  enseigne      String?
  montantTTC    Float
  detailLignes  Json?
  montantTVA    Float?
  categorie     String?
  statut        String

  createdAt     DateTime @default(now())
}

model AIConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String   // openai, anthropic, mistral, google, custom
  encryptedKey      String   @db.Text // AES-256 encrypted API key
  endpoint          String?  // For custom provider
  model             String
  temperature       Float    @default(0.3)
  maxTokens         Int      @default(2048)
  customSystemPrompt String? @db.Text

  lastTestedAt      DateTime?
  lastTestStatus    String   @default("UNTESTED") // UNTESTED, SUCCESS, FAILED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Phase 4: AI Usage tracking
model AIUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String   // openai, anthropic, mistral, google, custom
  model           String
  promptTokens    Int
  completionTokens Int
  totalTokens     Int
  estimatedCost   Float
  context         String   // 'chat', 'ocr', 'analysis'

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([context])
}

// Phase 4: User consent for RGPD compliance
model UserConsent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  consentType String    // AI_DATA_TRANSMISSION, DOCUMENT_EXTRACTION, SOCIAL_SHARING
  granted     Boolean
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([userId, consentType])
  @@unique([userId, consentType])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Float    @default(0)

  @@index([userId])
}

model UserChallenge {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  challengeId  String
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  progress     Int       @default(0)
  target       Int
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  expiresAt    DateTime?

  @@index([userId, status])
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastLoggedDate  DateTime?
  freezeTokens    Int       @default(0)
  gracePeriodEnds DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Friend {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(name: "UserFriends", fields: [userId], references: [id], onDelete: Cascade)

  friendId     String
  friend       User      @relation(name: "FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  status       String    // PENDING, ACTIVE, BLOCKED
  sharingLevel String    // SCORE_ONLY, SUMMARY, DETAILED

  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?

  @@unique([userId, friendId])
  @@index([userId, status])
}

model FriendInvitation {
  id            String    @id @default(cuid())
  inviterId     String
  inviter       User      @relation(name: "SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeEmail  String
  token         String    @unique
  expiresAt     DateTime
  status        String    // PENDING, ACCEPTED, DECLINED, EXPIRED

  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?

  @@index([token])
  @@index([inviterId, status])
}

model Group {
  id         String        @id @default(cuid())
  name       String
  type       String        // FAMILY, COLLEAGUES, FRIENDS, CUSTOM
  ownerId    String
  owner      User          @relation(name: "OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)

  anonymous  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  archivedAt DateTime?

  members    GroupMember[]

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId   String
  user     User     @relation(name: "GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  role     String   // OWNER, ADMIN, MEMBER
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId, userId])
  @@index([userId])
}

// Legacy model - to be migrated to Friend
model FriendLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(name: "UserFriendLinks", fields: [userId], references: [id], onDelete: Cascade)

  friendId  String
  status    String
  createdAt DateTime @default(now())
}

model Simulation {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String?
  scenarioType       String   // NEW_CHILD, JOB_CHANGE, RELOCATION, RETIREMENT, SALARY_CHANGE, CUSTOM
  inputData          Json     // Modified profile fields
  outputScore        Json     // Complete ScoreFiscal result

  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

model UserPreferences {
  id                         String  @id @default(cuid())
  userId                     String  @unique
  user                       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationsEnabled       Boolean @default(true)
  taxFactDailyEnabled        Boolean @default(false)
  fiscalCalendarAlertsEnabled Boolean @default(true)

  preferredMillesime         String?
  showEstimatedData          Boolean @default(true)
  showDeclaredData           Boolean @default(true)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model ProfilType {
  id        String   @id  // "enseignant", "medecin", "artisan", "cadre", "retraite", "etudiant", "smicard"
  data      Json     // ProfilFiscalComplete data
  score     Json     // Pre-calculated ScoreFiscal
  updatedAt DateTime @default(now()) @updatedAt
}

model UserNotificationPreferences {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyFactsEnabled   Boolean @default(false)
  fiscalAlertsEnabled Boolean @default(true)
  weeklyDigestEnabled Boolean @default(false)

  emailChannel        Boolean @default(true)
  pushChannel         Boolean @default(false)
  inAppChannel        Boolean @default(true)

  // Social notification settings (Phase 4)
  socialNotificationsEnabled Boolean @default(true)
  socialDigestMode           Boolean @default(false)
  socialEmailChannel         Boolean @default(true)
  socialPushChannel          Boolean @default(false)

  quietHoursStart     Int     @default(22) // 10pm
  quietHoursEnd       Int     @default(8)  // 8am
  timezone            String  @default("Europe/Paris")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ScoreHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  month           Int      // 1-12
  year            Int      // 2026
  scoreFiscalData Json     // Complete ScoreFiscal object snapshot
  confidenceScore Float
  millesime       String   // Which barème version was used

  createdAt       DateTime @default(now())

  @@unique([userId, year, month])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // DAILY_FACT, FISCAL_ALERT, WEEKLY_DIGEST, EVENT_TRIGGERED, FRIEND_REQUEST, FRIEND_ACCEPTED, GROUP_INVITE, GROUP_JOINED, LEADERBOARD_CHANGE, REFERENTIEL_UPDATE
  title     String
  body      String   @db.Text
  data      Json?
  channels  String[] // ['email', 'push', 'in-app']

  read      Boolean  @default(false)
  sentAt    DateTime @default(now())

  @@index([userId, read, sentAt])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizType   String   // GENERIC, PERSONALIZED, FOCUSED, CHALLENGE
  questions  Json     // Array of question objects
  answers    Json     // Array of user's answers
  score      Int      // Number of correct answers
  totalQuestions Int

  completedAt DateTime @default(now())

  @@index([userId, completedAt])
}

model SharedAnimation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  animationData Json     // Anonymized FiscalDayData
  expiresAt     DateTime
  viewCount     Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
}

model WrappedGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  data        Json     // Données du wrapped (totaux, top catégories, badges)
  shareId     String   @unique // ID public pour partage
  generatedAt DateTime @default(now())
  viewCount   Int      @default(0)

  @@unique([userId, year])
  @@index([userId])
}
